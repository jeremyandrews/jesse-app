<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs, so the bridge's pushes reach this Mac as well as the iPhone (MacPush.swift).
	  `development` matches the bridge's JESSE_APNS_ENV=sandbox, as the iPhone app's does.
	  The App ID com.tag1.JesseMac must carry the Push Notifications capability; Xcode's
	  automatic signing adds it on the first signed build.
	-->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
