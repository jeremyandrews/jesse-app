      "id": "code-review-checkout",
      "class": "code",
      "harnesses": [
        "claude-code",
        "codex"
      ],
      "workspace": "fixture",
      "fixture_base": "workflows-v1/base",
      "git_init": true,
      "remotes": [
        {
          "name": "github.com/acme/widget",
          "commits": [
            {
              "message": "Initial stats module",
              "files": {
                "README.md": "# widget\n\nTiny statistics helpers.\n",
                "src/stats.rs": "/// Sum of the values.\npub fn sum(xs: &[f64]) -> f64 {\n    xs.iter().sum()\n}\n"
              }
            },
            {
              "message": "Add average",
              "files": {
                "src/stats.rs": "/// Sum of the values.\npub fn sum(xs: &[f64]) -> f64 {\n    xs.iter().sum()\n}\n\n/// The arithmetic mean of the values.\npub fn average(xs: &[i64]) -> i64 {\n    let total: i64 = xs.iter().sum();\n    total / xs.len() as i64\n}\n"
              }
            }
          ]
        }
      ],
      "prompt": "Review the latest commit on acme/widget (github.com). In this environment its clone URL is {{remote_url:github.com/acme/widget}}. Check it out where the vault keeps code checkouts, review the head commit, and tell me which commit you reviewed (its hash) and what is wrong with it, if anything.",
      "assertions": [
        {
          "type": "file_exists",
          "path": "Code/github.com/acme/widget/.git"
        },
        {
          "type": "file_exists",
          "path": "Code/github.com/acme/widget/src/stats.rs"
        },
        {
          "type": "git_head_message_matches",
          "repo": "Code/github.com/acme/widget",
          "pattern": "^Add average"
        },
